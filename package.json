{
  "name": "dsh-billing-stats",
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only DSH token billing statistics with equivalent API cost, bill calibration, and explainable per-request reporting.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSHOOTING/dsh-billing-stats.git"
  },
  "homepage": "https://github.com/SSHOOTING/dsh-billing-stats#readme",
  "bugs": {
    "url": "https://github.com/SSHOOTING/dsh-billing-stats/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "src/index.js",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "billing",
    "billing-stats",
    "cost",
    "subscription",
    "api-cost",
    "token-usage",
    "observability"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./pricing": "./src/pricing.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "pricing/profiles.json",
    "install",
    "docs/BILL-FITTING.md",
    "docs/BILLING-MODEL.md",
    "docs/billing-explainer.html",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "RELEASE-NOTES-v0.1.0.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.2.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.mjs",
    "bill:import": "node bin/bill-import.mjs",
    "bill:fit": "node bin/bill-fit.mjs",
    "report": "node scripts/build-report.mjs"
  }
}
